# ===== LLM（任意 OpenAI 兼容接口：OpenAI / DeepSeek / 通义千问 / 本地 Ollama / vLLM 等）=====
OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=gpt-4o-mini
# 撰写报告用的模型（可选，建议用更强的模型），不填则与 LLM_MODEL 相同
# WRITER_MODEL=gpt-4o
# 部分推理模型不支持 temperature，不填则不传
# LLM_TEMPERATURE=0.2

# ===== 搜索数据源 =====
# 网页/业界搜索（推荐）：https://tavily.com（未配置时自动回退 DuckDuckGo）
TAVILY_API_KEY=
# Semantic Scholar API Key（可选，无 Key 触发 429 限流时系统自动无缝回退到 OpenAlex）
S2_API_KEY=
# GitHub Token（可选，提高 GitHub 仓库检索限额）
GITHUB_TOKEN=
# Hugging Face 镜像地址（可选，网络受限无法连接 huggingface.co 时使用）
# HF_ENDPOINT=https://hf-mirror.com

# ===== Web 服务与多人共享安全配置 =====
# 管理员口令（可选）：公网或团队共享部署时设置，锁定右上角「API 设置」防止他人篡改你的 API Key
# ADMIN_TOKEN=your-secret-admin-password
# 最大并发执行的调研任务数（超出自动进入排队队列）
# MAX_CONCURRENT_RUNS=2

# ===== Agent 默认参数（也可通过 CLI / Web 参数覆盖）=====
# MAX_SUB_QUESTIONS=5
# MAX_ITERATIONS=1
# RESULTS_PER_QUERY=5
# MAX_SOURCES_PER_TASK=8
# REPORT_LANGUAGE=中文
# ENABLE_RELEVANCE_FILTER=true
# MIN_RELEVANCE=5
# ENABLE_FULLTEXT=true
# MAX_FULLTEXT_SOURCES=3
# FULLTEXT_CHARS=3500
# VERIFY_MODE=annotate
# MAX_VERIFY_CLAIMS=36
# 若模型不支持 function calling，系统会自动回退为 json_mode，也可手动指定
# STRUCTURED_OUTPUT_METHOD=function_calling
